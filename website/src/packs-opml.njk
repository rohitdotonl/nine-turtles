---
pagination:
  data: collections.packsWithBlogs
  size: 1
  alias: pack
permalink: "/packs/{{ pack.fileSlug }}.opml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>{{ pack.data.title }}: a starter pack from {{ site.name }}</title>
    <ownerName>{{ site.name }}</ownerName>
    <docs>{{ site.url }}{{ pack.url }}</docs>
  </head>
  <body>
    <outline text="{{ pack.data.title }}" title="{{ pack.data.title }}">
      {%- for blog in pack.data.blogs %}
      <outline type="rss" text="{{ blog.name }}" title="{{ blog.name }}" xmlUrl="{{ blog.feed }}" htmlUrl="{{ blog.site }}" />
      {%- endfor %}
    </outline>
  </body>
</opml>
