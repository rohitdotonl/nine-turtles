---
layout: base.njk
---
<article class="post">
  <header class="post-head">
    <p class="kicker"><a href="/blog/">Blog</a></p>
    <h1>{{ title }}</h1>
    <p class="byline">By {{ author or site.name }} · <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
  </header>
  {{ content | safe }}
</article>
<p class="after-post">
  Follow this blog in any feed reader (nine turtles too): its feed is at
  <a href="/blog/feed.xml">nineturtles.app/blog/feed.xml</a>.
</p>
