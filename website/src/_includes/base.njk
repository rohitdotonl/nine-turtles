<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/literata-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the text</a>
    <header>
      <!-- The logo, the nine turtles (decision 0067), in the text color. The same drawing is in docs/logo/ and web/src/lib/Logo.svelte: change all three together. -->
      <a class="wordmark" href="/"><svg class="logo" viewBox="9 17 82 66" width="44" height="35" aria-hidden="true" focusable="false"><g fill="currentColor"><g transform="translate(18.50 22.70) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g><g transform="translate(46.10 22.70) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g><g transform="translate(73.70 22.70) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g><g transform="translate(24.50 50.30) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g><g transform="translate(52.10 50.30) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g><g transform="translate(79.70 50.30) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g><g transform="translate(18.50 77.90) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g><g transform="translate(46.10 77.90) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g><g transform="translate(73.70 77.90) scale(1.15)"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g></g></svg>{{ site.name }}</a>
      <a class="open" href="{{ site.app }}">Open the app</a>
    </header>
    <main id="main">
      {{ content | safe }}
    </main>
    <footer>
      <p>
        {{ site.name }} is open source:
        <a href="{{ site.source }}">read the code on GitHub</a>.
      </p>
    </footer>
  </body>
</html>
