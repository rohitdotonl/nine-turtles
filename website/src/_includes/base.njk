<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="{% if layout == "post.njk" %}article{% else %}website{% endif %}" />
    <!-- The share picture (decision 0142): the app icon's black tile, the nine turtles and the headline, the same on every page. -->
    <meta property="og:image" content="{{ site.url }}/images/share.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="nine turtles: Read people. Write back." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/literata-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/style.css?v={{ stylesVersion }}" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the text</a>
    <!-- The band (BRAND.md → "The website", "G set as C"): the app's grey sidebar, 248px wide, on a computer; a grey bar across the top on a tablet or phone. The front page, Rohit's letter, has no band: the same name and places sit along its top (decision 0169). -->
    <header class="{% if front %}top{% else %}band{% endif %}">
      <!-- The logo, the redrawn nine (decision 0067, docs/BRAND.md), in the text color, standing on the name's baseline, at the app sidebar's sizes (27px beside a 22px name). The same heavy drawing is in web/src/lib/Logo.svelte: change both together (docs/logo/README.md explains the large one). -->
      <a class="wordmark" href="/"><svg class="logo" viewBox="0 0 82.9 47.5" width="47" height="27" aria-hidden="true" focusable="false"><g fill="currentColor"><g transform="translate(9 6)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(35 6)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(61 6)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(18 25)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(44 25)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(70 25)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(9 44)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(35 44)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(61 44)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g></g></svg>{{ site.name }}</a>
      {%- set nav = [["/help/", "Help"]] %}
      <nav class="places" aria-label="The website">
        <ul>
          {%- for item in nav %}
          <li><a href="{{ item[0] }}"{% if page.url == item[0] or (item[0] == "/help/" and layout == "help.njk") %} aria-current="{% if page.url == item[0] %}page{% else %}true{% endif %}"{% endif %}>{{ item[1] }}</a></li>
          {%- endfor %}
          <li><a href="{{ site.app }}">Open the app</a></li>
        </ul>
      </nav>
    </header>
    <main id="main"{% if front %} class="front"{% endif %}>
      {{ content | safe }}
    </main>
    <footer>
      <!-- Two rows of links on the page's left edge (DESIGN.md, "The website's footer"). -->
      <nav class="links" aria-label="More about nine turtles">
        <ul>
          <li><a href="/help/">Help</a></li>
          <li><a href="/feed-finder/">Feed finder</a></li>
          <li><a href="/blog-checkup/">Blog checkup</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <nav class="links small" aria-label="The small print">
        <ul>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/refunds/">Refunds and cancelling</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
