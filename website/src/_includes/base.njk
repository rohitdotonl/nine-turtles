<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="{% if layout == "post.njk" %}article{% else %}website{% endif %}" />
    <!-- The share picture (decision 0142): the app icon's black tile, the nine turtles and the headline, the same on every page. -->
    <meta property="og:image" content="{{ site.url }}/images/share.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="nine turtles: Read people. Write back." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/atom+xml" title="The nine turtles blog" href="/blog/feed.xml" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/literata-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/style.css?v={{ stylesVersion }}" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the text</a>
    <header class="top">
      <div class="bar">
      <!-- The logo, the redrawn nine (decision 0067, docs/BRAND.md), in the text color, standing on the name's baseline. The same drawing is in docs/logo/ and web/src/lib/Logo.svelte: change all three together. -->
      <a class="wordmark" href="/"><svg class="logo" viewBox="0 0 82.9 47.5" width="49" height="28" aria-hidden="true" focusable="false"><g fill="currentColor"><g transform="translate(9 6)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(35 6)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(61 6)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(18 25)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(44 25)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(70 25)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(9 44)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(35 44)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g><g transform="translate(61 44)"><path d="M-9 3.5A7.5 9.5 0 0 1 6 3.5Z"/><circle cx="10" cy="-.6" r="2.9"/></g></g></svg>{{ site.name }}</a>
      {%- set nav = [["/tour/", "How it works"], ["/blog/", "Blog"]] %}
      <nav aria-label="The website">
        <ul>
          {%- for item in nav %}
          <li><a href="{{ item[0] }}"{% if page.url == item[0] or (item[0] == "/blog/" and layout == "post.njk") %} aria-current="{% if page.url == item[0] %}page{% else %}true{% endif %}"{% endif %}>{{ item[1] }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <a class="open" href="{{ site.app }}">Open the app</a>
      </div>
    </header>
    <main id="main"{% if wide %} class="wide-page"{% endif %}>
      {{ content | safe }}
    </main>
    <footer>
      <!-- Two centred rows of links (DESIGN.md, "The website's footer"). -->
      <nav class="links" aria-label="More about nine turtles">
        <ul>
          <li><a href="/tour/">A tour</a></li>
          <li><a href="/new-to-feeds/">New to feeds?</a></li>
          <li><a href="/feed-finder/">Feed finder</a></li>
          <li><a href="/packs/">Starter packs</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <nav class="links small" aria-label="The small print">
        <ul>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/refunds/">Refunds and cancelling</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
