<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="{% if layout == "post.njk" %}article{% else %}website{% endif %}" />
    <!-- The share picture (decision 0142): the app icon's black tile, the nine turtles and the headline, the same on every page. -->
    <meta property="og:image" content="{{ site.url }}/images/share.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="nine turtles: Read people. Write back." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/literata-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/literata-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/style.css?v={{ stylesVersion }}" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the text</a>
    <!-- The top (decision 0185; BRAND.md → "The website"): every page wears the front page's look, the logo (the name, the turtles walking on it) and the website's places along the top of one centred 640px column, no grey band. -->
    <header class="top">
      <!-- The logo: the nine turtles walk on the name, four out in front (decision 0291, docs/BRAND.md → "The logo"). The name stays real text; the turtles are drawn over it in Literata 600's own units (the name at 60, its baseline at 0), so they keep their places at any size; one turtle, drawn once and used nine times. They need Literata 600 (preloaded above) to land on the right letters. Source: docs/logo/four-in-front.svg. -->
      <a class="wordmark" href="/"><span aria-hidden="true">n&#305;ne turtles</span><span class="sr-only">{{ site.name }}</span><svg class="walkers" viewBox="0 -56 449 56" aria-hidden="true" focusable="false"><defs><g id="walker"><path d="M-9 3.5 A7.5 7.5 0 0 1 6 3.5 Z"/><circle cx="8.6" cy="0.6" r="2"/></g></defs><g fill="currentColor"><use href="#walker" transform="translate(52.14 -36.75) rotate(0.0) scale(0.8 0.8)"/><use href="#walker" transform="translate(90.31 -36.80) rotate(8.9) scale(0.8 0.8)"/><use href="#walker" transform="translate(204.31 -36.80) rotate(0.0) scale(0.8 0.8)"/><use href="#walker" transform="translate(277.16 -51.55) rotate(0.0) scale(0.8 0.8)"/><use href="#walker" transform="translate(299.42 -36.38) rotate(-19.0) scale(0.8 0.8)"/><use href="#walker" transform="translate(370.11 -2.80) rotate(0.0) scale(0.8 0.8)"/><use href="#walker" transform="translate(393.11 -2.80) rotate(0.0) scale(0.8 0.8)"/><use href="#walker" transform="translate(416.11 -2.80) rotate(0.0) scale(0.8 0.8)"/><use href="#walker" transform="translate(439.11 -2.80) rotate(0.0) scale(0.8 0.8)"/></g></svg></a>
      {%- set nav = [["/help/", "Help"]] %}
      <nav class="places" aria-label="The website">
        <ul>
          {%- for item in nav %}
          <li><a href="{{ item[0] }}"{% if page.url == item[0] or (item[0] == "/help/" and layout == "help.njk") %} aria-current="{% if page.url == item[0] %}page{% else %}true{% endif %}"{% endif %}>{{ item[1] }}</a></li>
          {%- endfor %}
          <li><a href="{{ site.app }}">Open the app</a></li>
        </ul>
      </nav>
    </header>
    <main id="main"{% if front %} class="front"{% endif %}>
      {{ content | safe }}
    </main>
    <footer>
      <!-- Two rows of links on the page's left edge (DESIGN.md, "The website's footer"). -->
      <nav class="links" aria-label="More about nine turtles">
        <ul>
          <li><a href="/help/">Help</a></li>
          <li><a href="/feed-finder/">Feed finder</a></li>
          <li><a href="/blog-checkup/">Blog checkup</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <nav class="links small" aria-label="The small print">
        <ul>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/refunds/">Refunds and cancelling</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
